new file mode 100755
index 00000000..2d10aa4a
--- /dev/null
+++ b/sdbuild/packages/xrt/post.sh
@@ -0,0 +1,9 @@
+#!/bin/bash
+
+set -e
+set -x
+
+target=$1
+
+sudo umount ${target}$XILINX_TOOLS_DIR
+sudo rm -rf ${target}$XILINX_TOOLS_DIR
diff --git a/sdbuild/packages/xrt/pre.sh b/sdbuild/packages/xrt/pre.sh
index 3e011349..44029786 100755
--- a/sdbuild/packages/xrt/pre.sh
+++ b/sdbuild/packages/xrt/pre.sh
@@ -7,8 +7,23 @@ target=$1
 script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
 
 sudo cp -f $script_dir/xrt_setup.sh $target/etc/profile.d
-cd $BUILD_ROOT/${PYNQ_BOARD}/petalinux_project
-petalinux-build -c zocl
-sudo cp -rf $BUILD_ROOT/${PYNQ_BOARD}/petalinux_project/build/tmp/sysroots-components/*/zocl/usr $target
-sudo cp -rf $BUILD_ROOT/${PYNQ_BOARD}/petalinux_project/build/tmp/sysroots-components/*/zocl/lib $target/usr/
+sudo cp -rf $PETALINUX_PROJECT_DIR/build/tmp/sysroots-components/*/zocl/usr/include/zocl $target/usr/include/
+sudo cp -rf $PETALINUX_PROJECT_DIR/build/tmp/sysroots-components/*/zocl/lib/modules $target/lib/
 
+sudo rm -f $target/root/xrt.patch
+sudo cp $PACKAGE_PATH/xrt/xrt.patch $target/root/xrt.patch
+
+sudo mkdir -p ${target}$XILINX_TOOLS_DIR
+sudo mount --bind $XILINX_TOOLS_DIR ${target}$XILINX_TOOLS_DIR
+
+sudo rm -rf $target/root/XILINX_TOOLS_DIR
+rm -rf $PACKAGE_PATH/xrt/XILINX_TOOLS_DIR
+echo $XILINX_TOOLS_DIR > $PACKAGE_PATH/xrt/XILINX_TOOLS_DIR
+sudo cp $PACKAGE_PATH/xrt/XILINX_TOOLS_DIR $target/root/XILINX_TOOLS_DIR
+rm -rf $PACKAGE_PATH/xrt/XILINX_TOOLS_DIR
+
+sudo rm -rf $target/root/XILINX_TOOLS_VERSION
+rm -rf $PACKAGE_PATH/xrt/XILINX_TOOLS_VERSION
+echo $XILINX_TOOLS_VERSION > $PACKAGE_PATH/xrt/XILINX_TOOLS_VERSION
+sudo cp $PACKAGE_PATH/xrt/XILINX_TOOLS_VERSION $target/root/XILINX_TOOLS_VERSION
+rm -rf $PACKAGE_PATH/xrt/XILINX_TOOLS_VERSION
